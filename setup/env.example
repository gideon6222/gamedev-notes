# Copy to C:\dev\.env (install.ps1 does this once). Never commit. Read by scripts/assets.py.
# Leave a line empty to skip that source; the script says which key a command needs.

# https://freesound.org/apiv2/apply  (free; the "client secret" is the token)
FREESOUND_KEY=

# https://itch.io/api-keys  (free; unlocks scripted downloads of free packs, e.g. KayKit, Tallbeard loops)
ITCH_KEY=

# https://poly.pizza/settings/api  (free, credit-limited)
POLYPIZZA_KEY=

# Optional: https://console.cloud.google.com  Web Fonts Developer API (not needed; the no-key endpoint works)
GOOGLE_FONTS_KEY=
